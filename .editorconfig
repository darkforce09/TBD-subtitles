# EditorConfig — whitespace rules for every file in the repository.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_style = space
indent_size = 4

[*.{toml,json,yml,yaml}]
indent_style = space
indent_size = 2

# Markdown hard breaks use trailing double spaces; prose and nested lists keep their own indent.
[*.md]
trim_trailing_whitespace = false
